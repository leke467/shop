{
  "appId": "com.shop.ecommerce",
  "appName": "Shop",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0A0A14",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#6366F1"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0A14"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
